# Repo-root env for `docker compose -f docker-compose.fullapp.yml`.
# Copy to `.env` and fill secrets before production deploy.
# apps/helios/.env is for local `yarn dev` only; Docker fullapp reads THIS file.

# --- Host ports (change if 3000/55432/56377 collide) ---
APP_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=56379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=helios

# --- App identity (required) ---
APP_URL=https://your-domain.example.com
JWT_SECRET=change-me-jwt-secret-min-32-chars
AUTH_SECRET=change-me-auth-secret-min-32-chars
DEMO_MODE=false
DEPLOY_ENV=production

# --- AI gateway (OpenAI-compatible; OpenCode/MCP optional) ---
HELIOS_AI_PROVIDER=openai
HELIOS_AI_MODEL=deepseek-v4-flash
HELIOS_AI_BASE_URL=https://ai.rjk66.cn/v1
HELIOS_AI_OPENAI_RESPONSES_STORE=false
OPENAI_API_KEY=sk-your-gateway-key
OPENAI_BASE_URL=https://ai.rjk66.cn/v1

# --- Optional first-boot superadmin override ---
# HELIOS_INIT_SUPERADMIN_EMAIL=admin@your-domain.com
# HELIOS_INIT_SUPERADMIN_PASSWORD=change-me

# --- Email (optional) ---
# RESEND_API_KEY=
# EMAIL_FROM=noreply@your-domain.com
