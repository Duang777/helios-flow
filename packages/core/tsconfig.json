{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@helios/core/modules/core/__integration__/helpers/*": [
        "./src/modules/core/__integration__/helpers/*"
      ],
      "@helios/core/helpers/integration/*": [
        "./src/helpers/integration/*"
      ]
    }
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
