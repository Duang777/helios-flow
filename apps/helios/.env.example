# Example environment configuration
# Copy this file to .env and adjust values for your environment.

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helios
POSTGRES_PORT=5432

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helios

# JWT secret for auth tokens (required)
JWT_SECRET=change-me-dev-secret
# Session/cookie signing secret used by auth flows and checkout password sessions.
# Preferred over JWT_SECRET when set.
AUTH_SECRET=change-me-dev-auth-secret
# Optional alias used by some NextAuth/Auth.js setups.
NEXTAUTH_SECRET=

# Demo autologin (optional; leave blank to disable).
# When both email and password are set, visitors landing on the homepage are
# signed in automatically with these credentials and dropped into the app —
# handy for demos with a single superadmin + tenant. NEVER set these in
# production. HELIOS_AUTOLOGIN_TENANT is only needed when the same email exists in
# more than one tenant.
# HELIOS_AUTOLOGIN_EMAIL=superadmin@acme.com
# HELIOS_AUTOLOGIN_PASSWORD=secret
# HELIOS_AUTOLOGIN_TENANT=

# Events transport (choose one)
# REDIS_URL=redis://localhost:6379
# or
# EVENTS_REDIS_URL=redis://localhost:6379

# Email provider (optional)
# RESEND_API_KEY=

# Public URL used in emails and onboarding flows
APP_URL=http://localhost:3000
# Additional trusted origins for app requests that must pass host validation.
# APP_URL is required in production for security-sensitive email links.
# In dev mode these values also govern the HMR WebSocket (/_next/webpack-hmr):
# add your public/reverse-proxy/Tailscale host here so remote dev access works,
# then restart the dev server. Non-allowlisted origins are still rejected.
# In Docker dev, the value must also be forwarded into the app container (see #2449).
# Example: APP_ALLOWED_ORIGINS=https://admin.example.com,https://ops.example.com
# APP_ALLOWED_ORIGINS=

# Enable self-service onboarding (default: false)
SELF_SERVICE_ONBOARDING_ENABLED=false
DEMO_MODE=true

# Hide the backend footer status bar (app version + terms/privacy links) (default: false)
HELIOS_HIDE_BACKEND_FOOTER=false

# Enable enterprise-only optional modules (default: false)
# Developer preview is free for local/dev usage.
# Production usage requires a commercial enterprise license.
# Details: https://github.com/helios/helios/blob/main/packages/enterprise/README.md
#
# Turning this ON also activates the `record_locks` module, which upgrades the
# always-on OSS optimistic-lock guard (see HELIOS_OPTIMISTIC_LOCK below) with the
# RICH collaborative-editing UX: live presence ("Jane is editing this record"),
# acquire/heartbeat, admin force-release, and a field-level merge/conflict
# dialog instead of the plain conflict bar. There is NO separate record_locks
# env flag — this switch is all it takes. record_locks LAYERS on top of the OSS
# floor (it never replaces it) and shares the HELIOS_OPTIMISTIC_LOCK kill switch, so
# the two never collide: one 409 shape, one conflict surface (merge dialog when
# its widget is mounted, OSS bar otherwise). See
# apps/docs/docs/framework/data-integrity/concurrency-locking.mdx.
HELIOS_ENABLE_ENTERPRISE_MODULES=false
# Enable enterprise SSO module (default: false)
# Requires HELIOS_ENABLE_ENTERPRISE_MODULES=true
HELIOS_ENABLE_ENTERPRISE_MODULES_SSO=false
# Optional comma-separated HTTPS origins for operator-approved private/on-prem OIDC endpoints.
# Every discovery, JWKS, token, and user-info destination is checked independently.
# HELIOS_SSO_OIDC_PRIVATE_ORIGIN_ALLOWLIST=https://idp.internal.example:8443

# Enterprise security module (MFA, passkeys, sudo)
# Active when enterprise modules are enabled and the security module is installed.
# Optional dedicated signing secret for MFA setup tokens.
# Falls back to AUTH_JWT_SECRET, AUTH_SECRET, or JWT_SECRET when left blank.
# HELIOS_SECURITY_MFA_SETUP_SECRET=change-me-mfa-setup-secret
# Enable enterprise security module (default: false)
# Requires HELIOS_ENABLE_ENTERPRISE_MODULES=true
HELIOS_ENABLE_ENTERPRISE_MODULES_SECURITY=false

# Enable the S3-compatible storage provider module (default: false).
# When true, `storage_s3` is added to enabledModules in modules.ts and the
# Integration Marketplace exposes the "S3 Object Storage" card.
# The provider can also be preconfigured from env vars — see the
# "S3 Storage Preconfiguration" block at the bottom of this file.
HELIOS_ENABLE_STORAGE_S3=false

HELIOS_SECURITY_TOTP_ISSUER="Helios"
HELIOS_SECURITY_TOTP_WINDOW=1
HELIOS_SECURITY_OTP_EXPIRY_SECONDS=600
HELIOS_SECURITY_OTP_MAX_ATTEMPTS=5
HELIOS_SECURITY_SUDO_DEFAULT_TTL=300
HELIOS_SECURITY_SUDO_MAX_TTL=1800
HELIOS_SECURITY_WEBAUTHN_RP_NAME="Helios"
# Defaults to the hostname from APP_URL / NEXT_PUBLIC_APP_URL when left blank.
HELIOS_SECURITY_WEBAUTHN_RP_ID=
HELIOS_SECURITY_RECOVERY_CODE_COUNT=10
HELIOS_SECURITY_MFA_EMERGENCY_BYPASS=false

# Outgoing email sender priority:
# 1. NOTIFICATIONS_EMAIL_FROM
# 2. EMAIL_FROM
# 3. ADMIN_EMAIL
NOTIFICATIONS_EMAIL_FROM=
EMAIL_FROM=

# Admin email to notify about onboarding submissions.
# Also used as the final sender fallback when the sender-specific vars above are empty.
ADMIN_EMAIL=ops@your-domain.com

# Auto-spawn workers when starting the app (default: true)
# Set to false to run workers separately in production
AUTO_SPAWN_WORKERS=true
# Local dev defaults to lazy shared workers: the first pending job starts one
# `queue worker --all` process. Use "per-queue" to start only ready queues.
HELIOS_AUTO_SPAWN_WORKERS_LAZY=true
HELIOS_AUTO_SPAWN_WORKERS_LAZY_MODE=shared

# Auto-spawn scheduler polling when QUEUE_STRATEGY=local (default: true)
# Set to false to run scheduler in a separate process
AUTO_SPAWN_SCHEDULER=true

# Dev-mode memory optimization: which workspace packages the `yarn dev`
# package watcher tracks. The watcher's memory footprint scales with the
# number of watched packages, so narrowing the scope is the main lever for
# reducing dev-mode RAM usage. Modes (CLI flag `--watch=<mode>` wins over env):
#   all            watch every package (default, unchanged)
#   auto-optimized watch only packages touched recently (git working tree +
#                  current-branch diff), re-checking every 2 minutes
#   popular        watch only the most frequently changed packages (ranked
#                  from recent git history; capped by HELIOS_WATCH_POPULAR_LIMIT)
#   env            watch exactly the packages listed in HELIOS_WATCH_PACKAGES
# The active mode is printed with an emoji at dev startup. See
# apps/docs/docs/appendix/troubleshooting.mdx (Choosing which packages the
# watcher tracks) for the full reference.
# HELIOS_WATCH_SCOPE=all
# HELIOS_WATCH_PACKAGES=core,ui,shared   # used when HELIOS_WATCH_SCOPE=env
# HELIOS_WATCH_POPULAR_LIMIT=6           # cap for HELIOS_WATCH_SCOPE=popular

# Base directory for local file-backed queues (default: ./.helios/queue)
QUEUE_BASE_DIR=./.helios/queue

# SSL Certificate Configuration
# Path to additional CA certificates for Node.js HTTPS connections
# Required for Raiffeisen Bank API which doesn't send complete certificate chain
# The GeoTrust EV RSA CA G2 intermediate certificate is needed for SSL verification
# Certificate valid until: July 2, 2030
# To update: curl -o certs/geotrust-ev-rsa-ca-g2.pem https://cacerts.digicert.com/GeoTrustEVRSACAG2.crt.pem
#NODE_EXTRA_CA_CERTS=./certs/geotrust-ev-rsa-ca-g2.pem

# Outbound request timeout for FX rate providers (NBP, Raiffeisen).
# Applied to both scheduled rate refreshes and ad-hoc fetches so a stalled
# upstream bank API cannot block rate jobs indefinitely (default: 15000 ms).
# CURRENCY_RATE_FETCH_TIMEOUT_MS=15000

# Hybrid query engine SQL logging (optional, default: false)
# Set to true to log raw SQL statements from the hybrid query engine.
QUERY_ENGINE_DEBUG_SQL=false

# Enable tree profiler for matching resources/entities (comma-separated filters, e.g. * - for all profilers,customers.*, customers.people)
# HELIOS_PROFILE=
# Enable detailed CRUD profiling for matching resources (comma-separated filters, e.g. customers.*, *)
# HELIOS_CRUD_PROFILE=
# Enable hybrid query engine profiling for matching entities (comma-separated filters, e.g. customers.*, customers.people)
# HELIOS_QE_PROFILE=

# Enable cache for CRUD API responses (default: false)
ENABLE_CRUD_API_CACHE=false

# Auto-reindex query indexes when coverage gaps are detected (default: true)
SCHEDULE_AUTO_REINDEX=true

# Skip immediate coverage recalculation on read (default: false)
OPTIMIZE_INDEX_COVERAGE_STATS=false

# Continue serving results from entity indexes when coverage gaps are detected (default: true)
FORCE_QUERY_INDEX_ON_PARTIAL_INDEXES=true

# Hashed search tokenization defaults
HELIOS_SEARCH_ENABLED=true
HELIOS_SEARCH_MIN_LEN=3
HELIOS_SEARCH_ENABLE_PARTIAL=true
HELIOS_SEARCH_HASH_ALGO=sha256
HELIOS_SEARCH_STORE_RAW_TOKENS=false
# Optional comma-separated blocklist of field name substrings to skip during tokenization
# HELIOS_SEARCH_FIELD_BLOCKLIST=password,token,secret,hash

# Search module debug logging (Meilisearch, vector search, reindex operations)
HELIOS_SEARCH_DEBUG=false

# Query index engine debug logging (search:source-has-tokens, coverage, etc.)
HELIOS_QUERY_INDEX_DEBUG=false

# CrudForm extended widget event emission (default: true)
# Controls: onFieldChange, onBeforeNavigate, onVisibilityChange, onAppEvent,
# transformFormData, transformDisplayData, transformValidation.
NEXT_PUBLIC_HELIOS_CRUDFORM_EXTENDED_EVENTS_ENABLED=true

# UMES DevTools panel (default: true)
# Enables the Ctrl+Shift+U keyboard shortcut to open the UMES DevTools panel.
# Set to false in production deployments where DevTools should be hidden.
NEXT_PUBLIC_UMES_DEVTOOLS=true

# Deals Map view tile source (optional)
# Default: Esri World Street Map (worldwide, WGS-84). Demo seed deals are located in China;
# the map still pans/zooms worldwide. Public OSM tiles often fail from mainland networks.
# Chinese labels (Gaode) — note GCJ-02 vs WGS-84 pin offset at high zoom:
# NEXT_PUBLIC_HELIOS_DEALS_MAP_TILE_URL=https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}
# NEXT_PUBLIC_HELIOS_DEALS_MAP_TILE_ATTRIBUTION=&copy; <a href="https://lbs.amap.com/">高德地图</a>
# NEXT_PUBLIC_HELIOS_DEALS_MAP_TILE_SUBDOMAINS=1234
# NEXT_PUBLIC_HELIOS_DEALS_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# NEXT_PUBLIC_HELIOS_DEALS_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri

# Mock gateway webhook HMAC secret (dev/test only)
# Used by the example mock payment gateway adapter to verify inbound webhooks.
# In production, configure per-tenant webhook credentials instead.
# MOCK_GATEWAY_WEBHOOK_SECRET=helios-mock-dev-webhook-secret

# Mock carrier webhook HMAC secret (dev/test only)
# Used by the example mock shipping carrier adapter to verify inbound webhooks.
# In production, configure per-tenant webhook credentials instead.
# MOCK_CARRIER_WEBHOOK_SECRET=helios-mock-dev-carrier-webhook-secret

# Example cross-module injection widgets (default: false)
# Enables example widgets injected into catalog/sales/crm pages.
# Example module todo + menu injections stay enabled regardless of this flag.
NEXT_PUBLIC_HELIOS_EXAMPLE_INJECTION_WIDGETS_ENABLED=false

# Example checkout pay-page test injections (default: false)
# Enables checkout summary/help wrappers used by integration tests only.
NEXT_PUBLIC_HELIOS_EXAMPLE_CHECKOUT_TEST_INJECTIONS_ENABLED=false

# Checkout origin allowlist (optional, comma-separated)
# Extra origins allowed to submit payments via the public pay-link endpoint.
# By default, only the server's own origin (derived from the request URL,
# Host, X-Forwarded-Host and X-Forwarded-Proto headers) is accepted.
# Use this when the pay page is served from a different domain than the API
# (e.g. a custom storefront or CDN domain).
# Example: CHECKOUT_ALLOWED_ORIGINS=https://shop.example.com,https://pay.example.com
# CHECKOUT_ALLOWED_ORIGINS=

# Toggle EAV backward compatibility for user-defined entities (custom field values)
# When true, DataEngine will also write to custom_field_values on create/update of custom entities.
# Default is false: values are only stored in custom_entities_storage.
ENTITIES_BACKCOMPAT_EAV_FOR_CUSTOM=false

# Cache strategy (default: memory). SQLite is a local single-server cache;
# use Redis for multi-server or latency-sensitive multi-write request paths.
CACHE_STRATEGY=sqlite

# Default TTL in milliseconds (optional)
CACHE_TTL=300000

# Max entries retained by the in-memory cache strategy before LRU eviction
# (default: 50000). Bounds memory for the process-wide cache singleton. A
# non-positive value disables the cap (unbounded — not recommended).
#CACHE_MEMORY_MAX_ENTRIES=50000

# The cache service is shared process-wide (a singleton) so cross-request
# caches actually hit. Set to off/false to fall back to a per-request cache
# instance (legacy behavior). Default: on.
#HELIOS_CACHE_SINGLETON=on

# Redis Configuration
#REDIS_PORT=6379
# Memory ceiling for the Redis container in Docker Compose (default: 512mb).
# Increase for production environments with many tenants or large cache payloads.
#REDIS_MAXMEMORY=512mb

# Redis configuration (for redis strategy)
#CACHE_REDIS_URL=redis://localhost:6379

# SQLite configuration (for sqlite strategy)
CACHE_SQLITE_PATH=./.helios/cache/cache.db

# JSON file configuration (for jsonfile strategy)
#CACHE_JSON_FILE_PATH=./.helios/cache/cache.json

# Database pooling settings
DB_POOL_MIN=5
# Conservative local/dev default. Increase explicitly for higher-concurrency deployments.
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=10000
# Connection-pinning guards (milliseconds). idle_in_transaction defaults to 120000 in every
# environment so a leaked open transaction cannot pin a pool connection forever; set to 0 to disable.
#DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=120000
# Opt-in server-side timeouts. Unset = no timeout (legacy behavior). Set to cap runaway
# queries / lock waits so they cannot exhaust the pool. Recommended in production.
#DB_STATEMENT_TIMEOUT_MS=30000
#DB_LOCK_TIMEOUT_MS=10000
# Background-worker DB connection budget. `helios queue worker --all` fits the sum of
# per-queue concurrency to this budget (one pooled connection per in-flight job) so workers
# cannot starve the request path. Defaults to DB_POOL_MAX. Keep
# web_pool_max + worker_pool_max + overhead <= Postgres max_connections.
#HELIOS_WORKERS_DB_CONNECTION_BUDGET=20

# Audit log retention windows
# Core resources (users, roles) keep access history longer to support investigations.
AUDIT_LOGS_CORE_RETENTION_DAYS=7
# Non-core reads rotate aggressively to limit storage.
AUDIT_LOGS_NON_CORE_RETENTION_HOURS=8
# Minimum gap between retention sweeps per process. 0 rotates on every write.
AUDIT_LOGS_ROTATE_INTERVAL_MS=60000

# ============================================================================
# Concurrency & Record Locking
# ============================================================================
# Optimistic-lock guard for concurrent edits. DEFAULT ON for every CRUD entity
# (no value needed). The guard is strictly additive at runtime: a request that
# does not send the `x-helios-ext-optimistic-lock-expected-updated-at` header passes
# through unchanged, so default ON costs zero behavior change for old clients.
#
# This single switch governs BOTH locking layers:
#   - OSS optimistic locking (always-on `updated_at` version compare).
#   - Enterprise `record_locks` (presence + merge dialog). When enabled, its
#     guard is a DECORATOR that runs the OSS compare first, then adds the rich
#     UX — so `off` here disables the enterprise layer too. There is no separate
#     record_locks toggle; activate it with HELIOS_ENABLE_ENTERPRISE_MODULES above.
#
# Accepted values:
#   unset / empty / `all`       → ON for every entity (the default).
#   `customers.company,sales.order` → allow-list: ON only for these entityTypes.
#   `off` / `false` / `0` / `no` / `disabled` / `none` → OFF (guard short-circuits).
# Read once at process boot — restart the app after changing it.
# HELIOS_OPTIMISTIC_LOCK=all

# Tenant data encryption (enabled by default)
TENANT_DATA_ENCRYPTION=yes
TENANT_DATA_ENCRYPTION_DEBUG=false
# Preferred fallback key when Vault is unavailable (use a strong 32+ char secret)
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=dev-tenant-encryption-fallback-key-32chars
# Legacy secondary fallback secret (optional)
TENANT_DATA_ENCRYPTION_KEY=
# Dedicated high-entropy pepper used to key lookup hashes (email_hash, external_email_hash, …)
# so they cannot be attacked with offline rainbow tables or correlated across installations
# (issue #2718). When unset, the encryption fallback/legacy keys above are used; if none are
# configured the lookup hash falls back to the legacy unkeyed digest. Never reuse AUTH_SECRET here.
LOOKUP_HASH_PEPPER=
# HashiCorp Vault configuration (disabled by default in local dev).
# Uncomment only if you actually run Vault locally; otherwise the fallback key above
# is used immediately.
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=dev-only-token
# VAULT_KV_PATH=secret/data
# Bound per-request deadline for Vault KV reads/writes so a degraded Vault
# does not stall encryption/decryption across the platform (default: 1000 ms).
# VAULT_REQUEST_TIMEOUT_MS=1000

# ============================================================================
# AI Providers, OCR, and Vector Search
# ============================================================================
# New apps ship with AI providers disabled. The unified AI module reads the
# `HELIOS_AI_*` variables below first; the legacy `OPENCODE_*` aliases stay
# supported as a backward-compatibility fallback when `HELIOS_AI_*` is unset.
# Defaults target OpenAI + `gpt-5-mini` — set `OPENAI_API_KEY` (and any
# overrides you want) to enable the AI Assistant.
# Docs:
# - AI Assistant: https://docs.helios.com/framework/ai-assistant/overview
# - AI settings: https://docs.helios.com/framework/ai-assistant/settings
# - Search/vector embeddings: https://docs.helios.com/user-guide/search

# AI Assistant provider selection (unified). Built-in ids: openai, anthropic,
# google, deepinfra, groq, together, fireworks, azure, litellm, ollama,
# openrouter, lm-studio.
# The legacy `OPENCODE_PROVIDER` is still honored as a fallback when this is unset.
# When paired with HELIOS_AI_MODEL, the selected provider must be configured; the
# runtime will not send a provider-specific model id to another provider.
HELIOS_AI_PROVIDER=openai

# AI Assistant model id. Format: `<provider>/<model>` or bare `<model>`
# (the dispatcher fills in the provider from HELIOS_AI_PROVIDER). Defaults to
# `gpt-5-mini` to pair with `HELIOS_AI_PROVIDER=openai`. Examples:
#   openai/gpt-5-mini
#   anthropic/claude-haiku-4-5-20251001
#   deepinfra/zai-org/GLM-5.1
#   meta-llama/llama-3.3-70b-instruct
#   meta-llama/Llama-3.3-70B-Instruct-Turbo
HELIOS_AI_MODEL=gpt-5-mini

# Per-module overrides (Phase 1 of the per-axis-overrides spec). When set,
# they win over the global `HELIOS_AI_PROVIDER` / `HELIOS_AI_MODEL` for the matching
# module's agent runs. Examples (uppercased from the agent's moduleId):
#   HELIOS_AI_CATALOG_PROVIDER=openai
#   HELIOS_AI_CATALOG_MODEL=openai/gpt-5-mini
#   HELIOS_AI_INBOX_OPS_PROVIDER=anthropic
#   HELIOS_AI_INBOX_OPS_MODEL=claude-haiku-4-5
# The legacy `<MODULE>_AI_MODEL` / `<MODULE>_AI_PROVIDER` forms are honored
# as backward-compatibility fallbacks.

# Provider / model ALLOWLIST (Phase 1780-5). Operator-defined hard ceiling
# on what (provider, model) the runtime accepts. Unset / empty → no
# restriction. When set, the settings UI is clipped to this subset, the
# chat-UI model picker only offers these values, the dispatcher rejects
# `?provider=` / `?model=` query params outside the list, and the
# model-factory falls back to a safe pair (with `console.warn` and an
# `allowlistFallback` field on the resolution) when an agent default,
# tenant override, or request override resolves to something blocked.
#
# All other override sources (settings UI, per-tenant overrides, per-agent
# defaults, HELIOS_AI_<MODULE>_MODEL, HELIOS_AI_MODEL) are clipped against this
# list — it is the ULTIMATE constraint.
#
#   HELIOS_AI_AVAILABLE_PROVIDERS=openai,anthropic
#   HELIOS_AI_AVAILABLE_MODELS_OPENAI=gpt-5-mini,gpt-5
#   HELIOS_AI_AVAILABLE_MODELS_ANTHROPIC=claude-haiku-4-5,claude-opus-4-7
# HELIOS_AI_AVAILABLE_PROVIDERS=
# HELIOS_AI_AVAILABLE_MODELS_OPENAI=
# HELIOS_AI_AVAILABLE_MODELS_ANTHROPIC=
#
# Per-agent chat override picker allowlist. This narrows only the models a
# user may pick in the chat footer for that agent; it does not change the
# default model. Agent id is uppercased and punctuation becomes `_`.
#   HELIOS_AI_AGENT_CATALOG_CATALOG_ASSISTANT_AVAILABLE_PROVIDERS=openai,lm-studio
#   HELIOS_AI_AGENT_CATALOG_CATALOG_ASSISTANT_AVAILABLE_MODELS_OPENAI=gpt-5-mini,gpt-4o

# OpenAI API key — REQUIRED to enable the AI Assistant when
# `HELIOS_AI_PROVIDER=openai` (the default). Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
OPENCODE_OPENAI_API_KEY=

# Legacy AI provider/model variables. Kept ONLY for backward compatibility —
# the unified runtime reads `HELIOS_AI_PROVIDER` / `HELIOS_AI_MODEL` first and falls
# back to these when the new variables are unset. New deployments should
# leave them blank.
# OPENCODE_PROVIDER=
# OPENCODE_MODEL=

# Additional native LLM providers. Leave blank until you intentionally
# configure one and set `HELIOS_AI_PROVIDER` to the matching id.
# anthropic: set HELIOS_AI_PROVIDER=anthropic + ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
OPENCODE_ANTHROPIC_API_KEY=
# google: set HELIOS_AI_PROVIDER=google + GOOGLE_GENERATIVE_AI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=
OPENCODE_GOOGLE_API_KEY=

# OpenAI-compatible LLM providers.
# deepinfra/groq/together/fireworks: set HELIOS_AI_PROVIDER to the provider id
# and fill the matching *_API_KEY below.
DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=
GROQ_API_KEY=
# GROQ_BASE_URL=
TOGETHER_API_KEY=
# TOGETHER_BASE_URL=
FIREWORKS_API_KEY=
# FIREWORKS_BASE_URL=
# azure/litellm/ollama: set HELIOS_AI_PROVIDER to the provider id and fill
# the API key plus base URL when that backend requires one.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
LITELLM_API_KEY=
LITELLM_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
# OpenRouter — unified API gateway (hundreds of models via one key).
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# Requesty — unified OpenAI-compatible gateway (provider/model naming, one key).
# REQUESTY_API_KEY=
# REQUESTY_BASE_URL=
# LM Studio — local model server (auto-detects loaded model when LM_STUDIO_API_KEY is set).
# LM_STUDIO_API_KEY=
# LM_STUDIO_BASE_URL=
# Override the OpenAI base URL (e.g. for a Cloudflare AI Gateway proxy).
# OPENAI_BASE_URL=

# Embedding-only providers for vector search.
MISTRAL_API_KEY=
COHERE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Vector search automatic indexing ships disabled by default. After setting an
# embedding provider key above, enable this and trigger a vector reindex from
# Settings > Search or the CLI.
HELIOS_DISABLE_VECTOR_SEARCH_AUTOINDEXING=true
# Legacy alias still supported: DISABLE_VECTOR_SEARCH_AUTOINDEXING=1
# Optional request cap for embedding providers (default: 3000 ms).
# VECTOR_EMBEDDING_TIMEOUT_MS=3000

# OCR model for image and PDF text extraction. OCR currently requires
# OPENAI_API_KEY to be set above.
OCR_MODEL=gpt-4o
# OCR_DEFAULT_PROMPT="Extract all text content from this image..."
# HELIOS_DEFAULT_ATTACHMENT_OCR_ENABLED=true
# HELIOS_ATTACHMENT_MAX_UPLOAD_MB=25
# HELIOS_ATTACHMENT_TENANT_QUOTA_MB=512

# Outbound request timeouts for the AI Assistant / OpenCode stack.
# OPENCODE_REQUEST_TIMEOUT_MS=30000
# OPENCODE_SSE_CONNECT_TIMEOUT_MS=15000
# OPENCODE_SEND_MESSAGE_TIMEOUT_MS=
# AI_API_REQUEST_TIMEOUT_MS=30000
# AI_OPENAPI_FETCH_TIMEOUT_MS=10000

# MCP server / OpenCode wiring (Cmd+K Code Mode stack).
# Native dev: the MCP server runs on the host (`yarn mcp:serve`, port 3001)
# and the OpenCode container reaches it via host.docker.internal. In the
# fully containerized stacks (docker-compose.fullapp*.yml) the dedicated mcp
# service provisions its own API key into a shared volume file — leave
# MCP_SERVER_API_KEY unset there, or the (likely invalid) env value shadows
# the auto-provisioned key and OpenCode -> MCP auth breaks.
#
# IMPORTANT: the variables marked (compose) below are docker-compose
# interpolation inputs — for the fullapp stacks set them in the REPO-ROOT
# .env (next to the compose files), not in this file; compose never reads
# apps/helios/.env.
# OPENCODE_URL=http://localhost:4096          App -> OpenCode base URL
# OPENCODE_MCP_URL=http://host.docker.internal:3001/mcp   (compose) OpenCode -> MCP URL
# OPENCODE_PORT=4096                          (compose) Host port for the OpenCode container
# MCP_PORT=3001                               (compose) Host port for the mcp service (fullapp.dev)
# MCP_URL=http://localhost:3001               App-side MCP health reporting URL
# MCP_SERVER_API_KEY=                         omk_... secret sent as x-api-key (host-MCP mode only)
# MCP_SERVER_API_KEY_FILE=                    Path to a provisioned key file (set by compose, not here)
# MCP_WAIT_FOR_APP_TIMEOUT=1800               (compose) Seconds the mcp service waits for the app on first boot

# ============================================================================
# Stripe Integration Preconfiguration
# ============================================================================
# If these values are set, the Stripe provider can preconfigure itself during
# tenant setup and can be rerun later with:
# yarn helios gateway_stripe configure-from-env --tenant <tenantId> --org <organizationId>
#
# Required for auto-preconfiguration:
# HELIOS_INTEGRATION_STRIPE_PUBLISHABLE_KEY=pk_test_...
# HELIOS_INTEGRATION_STRIPE_SECRET_KEY=sk_test_...
# HELIOS_INTEGRATION_STRIPE_WEBHOOK_SECRET=whsec_...
#
# Optional behavior:
# HELIOS_INTEGRATION_STRIPE_API_VERSION=2025-02-24.acacia
# HELIOS_INTEGRATION_STRIPE_ENABLED=true
# HELIOS_INTEGRATION_STRIPE_FORCE_PRECONFIGURE=false
#
# Notes:
# - Use publishable, secret, and webhook keys from the same Stripe mode.
# - The preset pins the default Stripe API version if you do not set one.
# - Legacy aliases HELIOS_STRIPE_* and STRIPE_* still work.
# HELIOS_INTEGRATION_STRIPE_PUBLISHABLE_KEY=
# HELIOS_INTEGRATION_STRIPE_SECRET_KEY=
# HELIOS_INTEGRATION_STRIPE_WEBHOOK_SECRET=
# HELIOS_INTEGRATION_STRIPE_API_VERSION=2025-02-24.acacia
# HELIOS_INTEGRATION_STRIPE_ENABLED=true
# HELIOS_INTEGRATION_STRIPE_FORCE_PRECONFIGURE=false

# ============================================================================
# Akeneo Sync Preconfiguration
# ============================================================================
# If these credentials are set, the Akeneo provider can preconfigure itself
# during tenant setup and can be rerun later with:
# yarn helios sync_akeneo configure-from-env --tenant <tenantId> --org <organizationId>
#
# Required for auto-preconfiguration:
# HELIOS_INTEGRATION_AKENEO_API_URL=https://your-instance.cloud.akeneo.com
# HELIOS_INTEGRATION_AKENEO_CLIENT_ID=
# HELIOS_INTEGRATION_AKENEO_CLIENT_SECRET=
# HELIOS_INTEGRATION_AKENEO_USERNAME=
# HELIOS_INTEGRATION_AKENEO_PASSWORD=
#
# Optional behavior:
# HELIOS_INTEGRATION_AKENEO_FORCE_PRECONFIGURE=false
# HELIOS_INTEGRATION_AKENEO_PRODUCT_LOCALE=en_US
# HELIOS_INTEGRATION_AKENEO_CATEGORY_LOCALE=en_US
# HELIOS_INTEGRATION_AKENEO_PRODUCT_CHANNEL=ecommerce
# HELIOS_INTEGRATION_AKENEO_IMPORT_CHANNELS=ecommerce,mobile
# HELIOS_INTEGRATION_AKENEO_IMPORT_ALL_CHANNELS=true
# HELIOS_INTEGRATION_AKENEO_CREATE_MISSING_CHANNELS=true
# HELIOS_INTEGRATION_AKENEO_SYNC_ASSOCIATIONS=true
# HELIOS_INTEGRATION_AKENEO_ATTRIBUTE_FAMILY_FILTER=clothing,cameras
#
# Advanced JSON overrides:
# HELIOS_INTEGRATION_AKENEO_PRODUCTS_SETTINGS_JSON={"settings":{"products":{"subtitleAttribute":"short_description"}}}
# HELIOS_INTEGRATION_AKENEO_CATEGORIES_SETTINGS_JSON={"locale":"en_US"}
# HELIOS_INTEGRATION_AKENEO_ATTRIBUTES_SETTINGS_JSON={"settings":{"attributes":{"familyCodeFilter":["clothing"]}}}
#
# Security:
# The Akeneo client validates API URLs server-side to prevent SSRF and credential
# exfiltration. By default only *.cloud.akeneo.com and *.akeneo.cloud hosts are
# allowed. Override the allowlist for self-hosted public custom domains:
# HELIOS_INTEGRATION_AKENEO_ALLOWED_HOSTS=pim.example.com,akeneo.staging.example.com
# Aliases (checked in priority order): HELIOS_INTEGRATION_AKENEO_ALLOWED_HOSTS,
#   HELIOS_AKENEO_ALLOWED_HOSTS, AKENEO_ALLOWED_HOSTS
# Hostnames that resolve to private, loopback, link-local, or reserved IPs are
# rejected before authenticated requests are sent. For trusted internal Akeneo
# deployments only, combine an exact host allowlist with:
# HELIOS_INTEGRATION_AKENEO_ALLOW_PRIVATE_URLS=true
#
# Notes:
# - Only one product locale is imported into base Helios fields at a time.
# - HELIOS_INTEGRATION_AKENEO_IMPORT_CHANNELS is comma-separated.
# - Legacy aliases HELIOS_AKENEO_* and AKENEO_* still work.
# - Leave the block commented out when Akeneo should not be preconfigured.
# HELIOS_INTEGRATION_AKENEO_API_URL=
# HELIOS_INTEGRATION_AKENEO_CLIENT_ID=
# HELIOS_INTEGRATION_AKENEO_CLIENT_SECRET=
# HELIOS_INTEGRATION_AKENEO_USERNAME=
# HELIOS_INTEGRATION_AKENEO_PASSWORD=
# HELIOS_INTEGRATION_AKENEO_ALLOWED_HOSTS=
# HELIOS_INTEGRATION_AKENEO_ALLOW_PRIVATE_URLS=false
# HELIOS_INTEGRATION_AKENEO_FORCE_PRECONFIGURE=false
# HELIOS_INTEGRATION_AKENEO_PRODUCT_LOCALE=
# HELIOS_INTEGRATION_AKENEO_CATEGORY_LOCALE=
# HELIOS_INTEGRATION_AKENEO_PRODUCT_CHANNEL=
# HELIOS_INTEGRATION_AKENEO_IMPORT_CHANNELS=
# HELIOS_INTEGRATION_AKENEO_IMPORT_ALL_CHANNELS=true
# HELIOS_INTEGRATION_AKENEO_CREATE_MISSING_CHANNELS=true
# HELIOS_INTEGRATION_AKENEO_SYNC_ASSOCIATIONS=true
# HELIOS_INTEGRATION_AKENEO_ATTRIBUTE_FAMILY_FILTER=
# HELIOS_INTEGRATION_AKENEO_PRODUCTS_SETTINGS_JSON=
# HELIOS_INTEGRATION_AKENEO_CATEGORIES_SETTINGS_JSON=
# HELIOS_INTEGRATION_AKENEO_ATTRIBUTES_SETTINGS_JSON=

# ============================================================================
# S3 Storage Preconfiguration
# ============================================================================
# If these credentials are set, the storage_s3 provider preconfigures itself
# during tenant setup and can be rerun later (for existing tenants) with:
# yarn helios storage_s3 configure-from-env --tenant <tenantId> --org <organizationId>
#
# For unattended deploys (Dokploy, Coolify, Kamal, etc.), use --all-tenants
# as a post-deploy hook to apply the preset to every active organization
# without tracking UUIDs in your deploy config:
# yarn helios storage_s3 configure-from-env --all-tenants
#
# The CLI exits non-zero on an incomplete preset so CI/automation can detect
# misconfiguration. Pass --force (or set HELIOS_INTEGRATION_STORAGE_S3_FORCE_PRECONFIGURE=true)
# to overwrite credentials that have already been stored for the tenant.
#
# The module itself is only loaded when HELIOS_ENABLE_STORAGE_S3=true (see above)
# — without that flag the preconfiguration block below is ignored.
#
# Required for auto-preconfiguration:
# HELIOS_INTEGRATION_STORAGE_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# HELIOS_INTEGRATION_STORAGE_S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# HELIOS_INTEGRATION_STORAGE_S3_REGION=eu-central-1
# HELIOS_INTEGRATION_STORAGE_S3_BUCKET=my-helios-attachments
#
# Optional behavior:
# HELIOS_INTEGRATION_STORAGE_S3_SESSION_TOKEN=
# HELIOS_INTEGRATION_STORAGE_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
# HELIOS_INTEGRATION_STORAGE_S3_FORCE_PATH_STYLE=false
# HELIOS_INTEGRATION_STORAGE_S3_FORCE_PRECONFIGURE=false
#
# Notes:
# - SESSION_TOKEN is only needed for short-lived STS credentials.
# - Leave ENDPOINT blank for AWS S3. Set it for MinIO, DigitalOcean Spaces,
#   Cloudflare R2, Backblaze B2, etc.
# - FORCE_PATH_STYLE must be true for MinIO and most self-hosted S3 services.
# - Leave the block commented out when S3 should not be preconfigured.
# HELIOS_INTEGRATION_STORAGE_S3_ACCESS_KEY_ID=
# HELIOS_INTEGRATION_STORAGE_S3_SECRET_ACCESS_KEY=
# HELIOS_INTEGRATION_STORAGE_S3_REGION=
# HELIOS_INTEGRATION_STORAGE_S3_BUCKET=
# HELIOS_INTEGRATION_STORAGE_S3_SESSION_TOKEN=
# HELIOS_INTEGRATION_STORAGE_S3_ENDPOINT=
# HELIOS_INTEGRATION_STORAGE_S3_FORCE_PATH_STYLE=false
# HELIOS_INTEGRATION_STORAGE_S3_FORCE_PRECONFIGURE=false

# ============================================================================
# Customer Portal Sessions
# ============================================================================
# Lifetime of long-lived `customer_session_token` cookies (default: 30 days).
# Short-lived `customer_auth_token` JWTs rotate independently on every refresh.
# CUSTOMER_SESSION_TTL_DAYS=30

# Maximum concurrent active sessions per customer user (default: 5).
# When a new session is issued above this cap, the oldest active sessions
# are soft-deleted so the total never exceeds the cap.
# MAX_CUSTOMER_SESSIONS_PER_USER=5

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Master switch to enable/disable rate limiting globally (default: true)
# Setting HELIOS_INTEGRATION_TEST=true also forces rate limiting off so integration
# test suites do not have to juggle this flag per app.
RATE_LIMIT_ENABLED=true

# Storage strategy: 'memory' (single instance) or 'redis' (distributed)
# Redis strategy uses REDIS_URL for connection. Falls back to memory if Redis is unavailable.
RATE_LIMIT_STRATEGY=memory

# Key prefix for rate limiter keys in storage (default: rl)
RATE_LIMIT_KEY_PREFIX=rl

# Number of trusted reverse proxies for X-Forwarded-For IP extraction (default: 0).
# Set to the number of proxies (nginx, CloudFlare, ALB, etc.) between clients and the app.
# 0 = direct mode: ignore forwarding headers and use endpoint-scoped fallback buckets.
# RATE_LIMIT_TRUST_PROXY_DEPTH=0

# Per-endpoint overrides (optional — sensible defaults are hardcoded)
# Auth endpoints use two-layer rate limiting:
#   1) IP-only layer (LOGIN_IP/RESET_IP) — caps total attempts from one IP
#   2) Compound layer (LOGIN/RESET) — caps attempts per IP+account pair (email is SHA-256 hashed)
# RATE_LIMIT_LOGIN_POINTS=5
# RATE_LIMIT_LOGIN_DURATION=60
# RATE_LIMIT_LOGIN_BLOCK_DURATION=60
# RATE_LIMIT_LOGIN_IP_POINTS=20
# RATE_LIMIT_LOGIN_IP_DURATION=60
# RATE_LIMIT_LOGIN_IP_BLOCK_DURATION=60
# RATE_LIMIT_RESET_POINTS=3
# RATE_LIMIT_RESET_DURATION=60
# RATE_LIMIT_RESET_BLOCK_DURATION=60
# RATE_LIMIT_RESET_IP_POINTS=10
# RATE_LIMIT_RESET_IP_DURATION=60
# RATE_LIMIT_RESET_IP_BLOCK_DURATION=60
# RATE_LIMIT_RESET_CONFIRM_POINTS=5
# RATE_LIMIT_RESET_CONFIRM_DURATION=300
# RATE_LIMIT_2FA_VERIFY_POINTS=5
# RATE_LIMIT_2FA_VERIFY_DURATION=300

# ============================================================================
# Meilisearch Configuration (for hybrid search)
# ============================================================================
# Meilisearch provides fast full-text fuzzy search capabilities.
# When configured, it becomes the primary search strategy.
# If not configured, the system falls back to token-based search.

# Meilisearch server URL (required for Meilisearch strategy)
# MEILISEARCH_HOST=http://localhost:7700

# Meilisearch API key (required for production, optional for development)
# MEILISEARCH_API_KEY=your_master_key_here

# Index prefix for tenant isolation (default: om)
# MEILISEARCH_INDEX_PREFIX=om

# Per-request deadline for Meilisearch operations (search, indexing,
# task waits). Prevents a degraded Meilisearch instance from stalling
# search, reindex workers, or onboarding (default: 30000 ms).
# MEILISEARCH_REQUEST_TIMEOUT_MS=30000

# ============================================================================
# InboxOps Configuration (email-to-ERP agent)
# ============================================================================
# HMAC secret for validating inbound email webhooks (required for InboxOps)
# INBOX_OPS_WEBHOOK_SECRET=
# Resend webhook signing secret (whsec_... from Resend webhook dashboard)
# Required if using Resend's native inbound email webhooks
# RESEND_WEBHOOK_SIGNING_SECRET=whsec_...
# Domain used for generating inbox forwarding addresses
# INBOX_OPS_DOMAIN=inbox.helios.local
# Optional: Override default LLM model for email extraction
# INBOX_OPS_LLM_MODEL=
# LLM extraction timeout in milliseconds (default: 90000)
# INBOX_OPS_LLM_TIMEOUT_MS=90000
# Minimum confidence threshold for auto-review (default: 0.5)
# INBOX_OPS_CONFIDENCE_THRESHOLD=0.5
# Maximum email text size in bytes sent to LLM (default: 204800)
# INBOX_OPS_MAX_TEXT_SIZE=204800
# Price mismatch tolerance as decimal fraction (default: 0.05 = 5%)
# INBOX_OPS_PRICE_MISMATCH_THRESHOLD=0.05

# ============================================================================
# Customer Portal Custom Domain (Phase 1–3)
# ============================================================================
# See .ai/specs/implemented/2026-04-08-portal-custom-domain-routing.md and
# docker/traefik/README.md. Required when custom-domain mappings are in use.

# Primary platform host — excluded from the Traefik domain-check middleware
# and treated as the platform pass-through host by the Node middleware.
PLATFORM_PRIMARY_HOST=helios.local

# Mandatory shared secret for /api/customer_accounts/domain-check
# (Traefik ForwardAuth gate). Generate with: openssl rand -hex 32
DOMAIN_CHECK_SECRET=

# Mandatory shared secret for the Node middleware's calls to
# /api/customer_accounts/domain-resolve. Generate with: openssl rand -hex 32
#
# HIGH-VALUE SECRET — DO NOT SHARE OR COMMIT.
# This secret also gates /api/customer_accounts/domain-resolve/all, which returns
# every active custom-domain mapping in the deployment. A leak lets an attacker
# enumerate every tenant's custom domains. Treat it like a database password:
#   - Generate per deployment with `openssl rand -hex 32` (never reuse across envs).
#   - Store only in your secrets manager (Vault, AWS Secrets Manager, doppler, etc.).
#   - Rotate immediately on any suspected leak (shell history dump, env audit,
#     ex-employee offboarding, leaked container image).
#   - Never log this value or paste it into chat/tickets/PR descriptions.
# Bulk and per-host resolve calls are rate-limited and access-logged so leaks are
# detectable in the application log stream — monitor for spikes on
# `[domain-resolve/all]` log lines.
DOMAIN_RESOLVE_SECRET=

# Internal origin the proxy uses to call domain-resolve. Defaults to
# http://app:3000 inside docker; set to your local app for `yarn dev`.
INTERNAL_APP_ORIGIN=http://127.0.0.1:3000

# DNS targets surfaced to admins in the back office.
CUSTHELIOS_DOMAIN_CNAME_TARGET=portal.helios.local
CUSTHELIOS_DOMAIN_A_RECORD_TARGET=

# Optional cache tuning (defaults: 60 / 300 / 10000)
# DOMAIN_CACHE_TTL_SECONDS=60
# DOMAIN_NEGATIVE_CACHE_TTL_SECONDS=300
# DOMAIN_CACHE_MAX_ENTRIES=10000

# Optional override for the marker header set on /_next/health
# CUSTOMER_DOMAIN_ORIGIN_HEADER=X-Helios-Origin

# Background verification (Phase 5) — both workers are scheduled
# automatically by `helios init` via the system scheduler.
# DNS auto-verification scan interval (default 300s = 5 min).
# DOMAIN_AUTO_VERIFY_INTERVAL_SECONDS=300
# TLS retry scan interval (default 1800s = 30 min).
# DOMAIN_TLS_RETRY_INTERVAL_SECONDS=1800
# Per-run cap for the TLS retry worker (default 50).
# DOMAIN_TLS_RETRY_BATCH=50
# Failure-rate threshold (0–1) that triggers worker-level backoff (default 0.8).
# DOMAIN_TLS_RETRY_FAILURE_THRESHOLD=0.8
# Maximum tls_retry_count before the worker stops retrying (default 6).
# DOMAIN_TLS_MAX_RETRIES=6

# --- Traefik (only for docker-compose.fullapp{,.dev}.yml) ---
# Let's Encrypt contact address.
ACME_EMAIL=
# Defaults to LE production. Dev compose defaults to LE staging.
# TRAEFIK_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443
# TRAEFIK_DASHBOARD_PORT=8081

# --- Email / Communication Channels (per-user email integration) ---
# All optional. The two signing secrets fall back to KMS_MASTER_KEY (via HKDF)
# and only fail closed in production if neither they nor KMS_MASTER_KEY are set.
# HMAC key for inbound reply-threading tokens. Generate: openssl rand -hex 32
# HELIOS_THREAD_TOKEN_SECRET=
# AES key for the per-user OAuth state cookie. Generate: openssl rand -hex 32
# HELIOS_HUB_OAUTH_STATE_KEY=
# Inbound poll scheduler tick cadence (seconds).
# HELIOS_HUB_POLL_SCHEDULER_TICK_SECONDS=60
# Gmail push (Pub/Sub) — leave unset to fall back to polling.
# HELIOS_GMAIL_PUBSUB_TOPIC=
# HELIOS_GMAIL_PUBSUB_AUDIENCE=
# HELIOS_GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Push-subscription renewal lead times (hours before expiry).
# HELIOS_PUSH_RENEWAL_GMAIL_LEAD_HOURS=24
# IMAP/SMTP provider safety + tuning. Keep the two ALLOW_* off in production.
# HELIOS_CHANNEL_IMAP_ALLOW_INSECURE_TRANSPORT=false
# HELIOS_CHANNEL_IMAP_ALLOW_INTERNAL_HOSTS=false
# HELIOS_CHANNEL_IMAP_HARD_CAP_PER_POLL=200
# HELIOS_CHANNEL_IMAP_SOCKET_TIMEOUT_MS=60000

# --- Logging (structured logging facade, @helios/shared/lib/logger) ---
# Docs: apps/docs/docs/framework/runtime/logging.mdx
# Global level threshold: debug | info | warn | error.
# Default: debug in dev, info in production.
# HELIOS_LOG_LEVEL=info
# Human-friendly console lines instead of pino JSON on the server.
# Default: on outside production, off in production. Set to 0 for raw JSON in
# dev — e.g. when piping local logs to Loki/Grafana. No redaction in pretty mode.
# HELIOS_LOG_PRETTY=1
# Route server logs to stderr — only for processes whose stdout is a protocol
# channel (the MCP stdio server sets this itself). Default: stdout.
# HELIOS_LOG_DESTINATION=stderr

# --- Node.js Runtime ---
# Uncomment to cap the V8 heap and force proactive GC instead of growing until near system RAM.
# Use ≥4096 if you also run `next build` locally — the TypeScript checker needs >3 GB on this codebase.
# For Docker-based dev the cap is set automatically in docker-compose.fullapp.dev.yml.
# NODE_OPTIONS=--max-old-space-size=3072

# --- Test-only Host spoof (NEVER set in production) ---
# Activates only when NODE_ENV=test. Used by Playwright to drive arbitrary
# Host values without DNS. Generate with: openssl rand -hex 32
# FORCE_HOST_SECRET=
